{
  "name": "cset-ui",
  "version": "0.3.1",
  "description": "CSET shared UI components (Svelte 5 + Tailwind v4 + bits-ui), Blueprint/Schematic design system",
  "type": "module",
  "license": "UNLICENSED",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "fonts", "styles.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "package": "svelte-package && cp src/lib/styles.css styles.css",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "@sveltejs/kit": "^2.0.0"
  },
  "dependencies": {
    "bits-ui": "^2.18.1"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/package": "^2.5.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.3"
  }
}
